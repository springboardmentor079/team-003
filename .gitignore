# Dependencies
**/node_modules/

# Build output
**/dist/
**/dist-ssr/
**/build/

# Local environment files (keep secrets out of the repo)
**/.env
**/.env.local
**/.env.*.local

# Python backend (virtualenv, bytecode, local SQLite database)
**/.venv/
**/__pycache__/
**/*.pyc
**/*.db

# Agent / editor tooling (local only)
.agents/
**/.agents/
.claude/
.vscode/*
!.vscode/extensions.json
.idea/
# Local design-tool plugin bundles (not part of the app)
Frontend/public/plugins/

# Logs
**/*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
